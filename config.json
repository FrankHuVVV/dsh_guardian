{
  "dshHome": "<YOUR_DSH_HOME>",
  "profile": "desktop",
  "profileDir": "<YOUR_PROFILE_DIR>",
  "launchMode": "electron-exe",
  "launch": ["<YOUR_DSH_EXE>"],
  "expectedClientVersion": "<YOUR_CLIENT_VERSION>",
  "portMode": "dynamic",
  "port": 0,
  "startTimeoutMs": 90000,
  "settleMs": 8000,
  "probeStartTimeoutMs": 45000,
  "probeSettleMs": 8000,
  "maxBisectMs": 300000,
  "singleInstance": "kill-first",
  "killGraceMs": 5000,
  "lockTimeoutMs": 600000,
  "snapshotMode": "exact",
  "snapshotStorage": "content-addressed-hardlink",
  "storeDir": "backups\\_store",
  "storeGcOnPrune": true,
  "trackedFiles": [
    "cordis.patch.yml",
    "package.json",
    "cordis.yml",
    "pnpm-workspace.yaml",
    "pnpm-lock.yaml"
  ],
  "trackedRuntimePaths": ["node_modules", ".plugin-manager", ".dsh-market"],
  "trackedSourcePaths": ["<YOUR_SOURCE_PLUGIN>", "<YOUR_LINK_PLUGIN>"],
  "sourceInclude": ["**/*"],
  "sourceExclude": ["node_modules", ".git", ".cache", ".pnpm-store", "dist", "cache", "*.log"],
  "dshHomeTrackedPaths": [
    "mcp",
    "storages",
    ".agent-presets",
    "settings.yaml",
    "settings.yaml.imported"
  ],
  "dshHomeExclude": [
    "sessions",
    "cache",
    "dsh-runtimes",
    "attachments",
    "llm-deepseek",
    ".credentials.yaml"
  ],
  "storageVolatilePaths": [
    "session_projcache/sessions",
    "workspace.json"
  ],
  "volatileClosurePaths": [
    "dshHome/storages",
    "profile/.plugin-manager"
  ],
  "sharedDependencyRoots": ["<YOUR_SHARED_DEPS>"],
  "driftPolicy": "adopt-if-healthy",
  "crashPolicy": "resume",
  "verifyPluginLoad": true,
  "blockOnClientMismatch": true,
  "keepTransactions": 20,
  "keepLkg": 3,
  "pruneKeepLabels": []
}
